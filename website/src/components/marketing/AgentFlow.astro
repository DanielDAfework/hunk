---
/**
 * The agent story is carried by the screenshot. The commands only answer
 * "who runs what", so they stay as short as that question.
 */
const roles = [
  { who: "You", commands: ["hunk diff"] },
  {
    who: "Your agent",
    commands: ["hunk session review --repo . --json", "hunk session comment add --repo ."],
  },
] as const;
---

<div class="agent-cols">
  <figure class="agent-shot">
    <img
      src="/agent-note-zoom.webp"
      alt="An agent note explaining a change, rendered in the diff directly above the lines it describes"
      width="924"
      height="486"
      loading="lazy"
    />
  </figure>

  <div class="agent-flow">
    <dl>
      {
        roles.map(({ who, commands }) => (
          <div>
            <dt>{who}</dt>
            <dd>
              {commands.map((command) => (
                <code>{command}</code>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="pills">
      <a href="/docs/agents/review-with-an-agent/">
        How agent review works <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</div>
